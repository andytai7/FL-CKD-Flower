# ── Environments, caches, tooling ───────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.pytest_cache/
logs/
.DS_Store
.ipynb_checkpoints/
~$*

# ── Secrets and run-time artefacts: never committed ─────────────────────────────────────────
# Deployment keys (openssl), Flower app bundles, local SuperLink state.
*.key
*.crt
*.csr
*.srl
*.pem
.env*
*.fab
.flwr/

# ── Datasets: generated, not published ──────────────────────────────────────────────────────
# Build the cohorts locally instead: `uv run ckd-clinics`, the V2 suites via
# `uv run python -m data.synthesize_v2 --suites all`, the external cohorts via the
# data/external/*_to_clinics.py mappers over their public sources.
data/**/*.csv
!data/synthetic_ckd_data.csv
data/clinics/
data/clinics_ladder/
data/clinics_*/
data/external/nhanes/
data/external/synthea/
data/external/uci_ckd/
data/external/dermamnist/
data/external/ecg_cinc2017/
# Helios FHIR server runtime: downloaded HFS binary, SQLite store, generated seed, view outputs.
data/helios/

# ── Not published: internal project material, kept on the maintainer's machine ──────────────
# The public repository carries code, notebooks and raw results only.
CLAUDE.md
docs/
diagrams/
paper/
archive/
retreat_presentation/
practice_1/
data/VERSIONS.md
data/manifest_v1.sha256
data/external/SOURCES.md
.claude/
.agents/
.archon/
.mcp.json
.vscode/
.dvc/
.dvcignore
# Paper/report tooling and the scripts index (they describe unpublished material).
scripts/paper.sh
scripts/paper-zip.sh
scripts/README.md
