# Python / uv
.venv/
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.pytest_cache/

# Generated per-clinic datasets — regenerate with `uv run ckd-clinics`, never committed.
data/clinics/
data/clinics_ladder/
# Raw external payloads (NHANES XPTs, Synthea zips/FHIR bundles, UCI CKD, DermaMNIST npz,
# CinC 2017 ECG) — re-download via the URLs + checksums in data/external/SOURCES.md, then
# re-run the data/external/*_to_clinics.py mappers. Only the mappers and SOURCES.md are tracked.
data/external/nhanes/
data/external/synthea/
data/external/uci_ckd/
data/external/dermamnist/
data/external/ecg_cinc2017/
# Flower App Bundles produced by `flwr build` / `flwr run`.
*.fab
# Deployment secrets/keys (created by docs/DEPLOYMENT.md's openssl steps) and run-time artifacts —
# none must ever be committed. Ad-hoc patient extracts land under data/** (any CSV except the
# committed synthetic fixture).
*.key
*.crt
*.csr
*.srl
*.pem
.env*
.flwr/
data/**/*.csv
!data/synthetic_ckd_data.csv

# OS
.DS_Store

results/

# LaTeX build products from a local compile. The *inputs* the report needs — paper/figures/,
# paper/tables/, paper/generated/ — ARE committed, deliberately: an Overleaf upload must build
# without running Python, and the committed artefacts are the audit trail for the numbers in the
# report. Regenerate them with `./scripts/paper.sh --recompute`.
paper/*.pdf
paper/*.aux
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.run.xml
paper/*.fls
paper/*.fdb_latexmk
