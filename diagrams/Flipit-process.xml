        <mxCell id="2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#000000;fontStyle=1;" value="FLIP-IT End-to-End Process: From Practice Onboarding to the Consultation" vertex="1">
          <mxGeometry height="34" width="1120" x="350" y="380" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=2;" value="The model travels to the data, so patient records never leave the practice. One pipeline, different GP practices, one shared CKD risk model." vertex="1">
