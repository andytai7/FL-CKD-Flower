        </mxCell>
        <mxCell id="7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" value="Stage 2: data and census" vertex="1">
          <mxGeometry height="20" width="140" x="840" y="678" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" value="Stage 3: federated rounds" vertex="1">
          <mxGeometry height="20" width="140" x="840" y="887" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" value="Stage 4: approval" vertex="1">
          <mxGeometry height="20" width="140" x="840" y="1062" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" value="Stage 5: deploy" vertex="1">
          <mxGeometry height="20" width="140" x="840" y="1237" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" value="Stage 6: consult" vertex="1">
          <mxGeometry height="20" width="140" x="840" y="1412" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;ONBOARDING (one time, with practice IT)&lt;/b&gt;&lt;br&gt;• Practice generates a private P-384 key pair&lt;br&gt;• Practice IT installs one Flower SuperNode and points it at the practice&#39;s own FHIR server&lt;br&gt;• Cohort validated locally: ckd-fhir-extract prints exclusion accounting" vertex="1">
          <mxGeometry height="152" width="500" x="370" y="510" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;CONSORTIUM ADMIN&lt;/b&gt;&lt;br&gt;• Runs the SuperLink on central infrastructure (TLS + key-based admission)&lt;br&gt;• Registers each practice&#39;s public key (flwr supernode register)&lt;br&gt;• Only registered practices can ever join a run, and any practice can be withdrawn" vertex="1">
          <mxGeometry height="135" width="500" x="950" y="510" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;DATA PIPELINE (runs inside the practice)&lt;/b&gt;&lt;br&gt;• Tomedo practice software → nightly export → the practice&#39;s PostgreSQL / FHIR server&lt;br&gt;• extract_features.sql builds the canonical 16-column feature contract&lt;br&gt;• Pseudonymised extract: no names, no identifiers, no patientid column" vertex="1">
          <mxGeometry height="152" width="500" x="370" y="702" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;ROUND ZERO (rule-based server agent)&lt;/b&gt;&lt;br&gt;• Census: each practice reports its patient count N&lt;br&gt;• Enforces the agreed privacy policy: one global target (ε, δ) for everyone&lt;br&gt;• Inverts the privacy accountant per clinic → its own (batch size, noise σ) plan&lt;br&gt;• Plan dispatched to each SuperNode inside the ConfigRecord" vertex="1">
          <mxGeometry height="169" width="500" x="950" y="702" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;FEDERATED TRAINING (repeats about 10 rounds)&lt;/b&gt;&lt;br&gt;• SuperNode receives the current global model&lt;br&gt;• Trains locally on its own cohort, using DP-SGD with its own (batch, σ) plan&lt;br&gt;• Returns a SecAgg+ masked model update" vertex="1">
          <mxGeometry height="118" width="500" x="370" y="911" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;SUPERLINK AGGREGATION (per round)&lt;/b&gt;&lt;br&gt;• SecAgg+ unmasking opens only the weighted SUM, so individual updates stay hidden&lt;br&gt;• FedAvg over the sum → the new global model for the next round&lt;br&gt;• Every round logs global AND worst-practice AUROC / sensitivity" vertex="1">
          <mxGeometry height="135" width="500" x="950" y="911" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;GOVERNANCE GATE&lt;/b&gt;&lt;br&gt;• Global and worst-practice AUROC / sensitivity clear the agreed floor&lt;br&gt;• Membership-inference leakage audit re-run on the final model&lt;br&gt;• Clinical review (docport / IKIM / RUB) + legal review (Jorzig &amp;amp; Partner) → release decision" vertex="1">
          <mxGeometry height="135" width="800" x="510" y="1086" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;MODEL BACK IN THE PRACTICE&lt;/b&gt;&lt;br&gt;• Approved model exported as a JSON artifact, paired with the practice-local scaler.&lt;br&gt;• Delivered onto the practice machine, so scoring runs fully on-site.&lt;br&gt;• No server connection needed at consultation time." vertex="1">
          <mxGeometry height="135" width="500" x="370" y="1261" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;CONSORTIUM OVERSIGHT (continuous)&lt;/b&gt;&lt;br&gt;• Every run logged at the SuperLink: rounds, ε spend, dual-level metrics&lt;br&gt;• A practice can pause or leave at any time. Its key is unregistered, and no data was ever held centrally&lt;br&gt;• Later rounds refresh the model as cohorts evolve" vertex="1">
          <mxGeometry height="135" width="500" x="950" y="1261" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;AT THE POINT OF CARE&lt;/b&gt;&lt;br&gt;• Clinician opens the local form and enters routine features.&amp;nbsp;&lt;br&gt;• Gets P(CKD stage ≥ 3) with the practice&#39;s calibrated flag.&lt;br&gt;• High-risk patients offered early diagnostics and guideline follow-up.&lt;br&gt;• The score informs the consultation. The doctor decides the next steps." vertex="1">
          <mxGeometry height="152" width="500" x="370" y="1436" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;The Clinic Sees&lt;/b&gt;&lt;br&gt;• One time: agree to join, hand IT the install sheet&lt;br&gt;• During training: no change to daily work&lt;br&gt;• After implementation, the CKD risk score shows up as routine decision support in the consultation" vertex="1">
          <mxGeometry height="90" width="1080" x="370" y="1628" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;• Solid arrow: model weights and model updates  ·  Dashed arrow: planning metadata (keys, census N, config)&lt;br&gt;• Green: inside the practice trust boundary  ·  Blue: central consortium  ·  Yellow: review / decision gate" vertex="1">
