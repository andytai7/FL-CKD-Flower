        <mxCell id="5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#36476B;fontStyle=1;" value="CENTRAL CONSORTIUM: one SuperLink, run by docport / IKIM KITE" vertex="1">
