#!/usr/bin/env bash
# prose-lint: deterministic style enforcement.
# Exit 0 clean, 1 on hits, 2 on setup/read failure.
# Engine: perl (stock macOS), single process, no external dependencies.
# Dots in phrase patterns also match curly apostrophes, on purpose.
# Checks: dash, emoji, banned phrase (incl. echo openers), double
# negative (buried affirmative), not-but rhetorical inversion.
command -v perl >/dev/null || { echo "prose-lint: perl not found" >&2; exit 2; }
exec perl -we '
  binmode(STDOUT, ":encoding(UTF-8)");
  my $status = 0;
  for my $f (@ARGV) {
    open my $fh, "<:encoding(UTF-8)", $f or do {
      warn "prose-lint: cannot read $f: $!\n"; $status = 2; next;
    };
    my $n = 0;
    while (defined(my $line = <$fh>)) {
      $n++;
      my @hits;
      push @hits, "dash"   if $line =~ /[\x{2012}-\x{2015}\x{2212}]/;
      push @hits, "emoji"  if $line =~ /[\x{1F300}-\x{1FAFF}\x{2600}-\x{27BF}\x{FE0F}]/;
      push @hits, "phrase" if $line =~ /worth noting|delve|in today.s|at its core|not just .*but|let.s dive|a testament to|in conclusion|important to note|in other words|this means that|in essence/i;
      push @hits, "dblneg" if $line =~ /not\s+(?:uncommon|unusual|unlikely|unclear|uncertain|unimportant|unrelated|unreasonable|undeniable|unavoidable|infrequently?|impossible|incorrect|insignificant|ineffective|negligible|without)|no\s+evidence\s+to\s+(?:deny|reject|exclude|rule\s+out)|not\s+possible\s+without|cannot\s+be\s+(?:excluded|ruled\s+out)/i;
      push @hits, "inversion" if $line =~ /\bnot\s+(?!just\b)[\w][\x{2019}\x27\w ,-]{1,45}?[\w-],?\s+but\b/i;
      if (@hits) {
        print "$f:$n: $line";
        print "  ^ " . join(",", @hits) . ": $f\n";
        $status = 1;
      }
    }
    close $fh;
  }
  exit $status;
' "$@"
